<Page x:Class="TestMathEquationControls.CompositeControls.PolynomialQuotientField"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestMathEquationControls.CompositeControls"
        Title="PolynomialQuotientField"
        xmlns:poly="clr-namespace:MathEquationControls.CustomControls.Polynomial;assembly=MathEquationControls"
		xmlns:mathctrls="clr-namespace:MathEquationControls.CustomControls;assembly=MathEquationControls"
		xmlns:converters="clr-namespace:MathEquationControls.Converters;assembly=MathEquationControls"
        mc:Ignorable="d"        
		Height="Auto" Width="Auto">
    <Page.Resources>
        <converters:BigIntegerToStringConverter x:Key="BigInteger2StringConverter" />

        <Style x:Key="WrapPanelStyle" TargetType="WrapPanel">
            <Setter Property="HorizontalAlignment"  Value="Center" />
            <Setter Property="VerticalAlignment"  Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="1" Style="{DynamicResource WrapPanelStyle}">
            <Label Content="X =" Style="{DynamicResource TextControlStyle}" />
            <poly:Coefficient x:Name="xIntegerValue"
								 Value="{Binding Path=BaseValue, Mode=TwoWay}"
								 Style="{DynamicResource TextControlStyle}" 
								 ValueChanged="numberboxControl_ValueChanged"
								 />

        </WrapPanel>

        <WrapPanel Grid.Row="2" Style="{DynamicResource WrapPanelStyle}">
            <TextBlock Text="ƒ" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <poly:PolynomialControl x:Name="dividendPolynomialCtrl"
                                         Width="Auto" Height="Auto" MinHeight="30"										 
										 Style="{DynamicResource PolynomialControlStyle}" />
        </WrapPanel>

        <WrapPanel Grid.Row="3" Style="{DynamicResource WrapPanelStyle}">
            <TextBlock Text="ƒ" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text="(" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text="X" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=")" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBox x:Name="integerTotal_Dividend" Text="0" Style="{DynamicResource TextBoxStyle}" />
        </WrapPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="13" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="13" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="13" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="13" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="13" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" />
            <TextBlock Grid.Column="1" Text="ƒ" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Grid.Column="2" Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBlock Grid.Column="3" Text="≡" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Grid.Column="4" Text=" " Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Grid.Column="5" x:Name="quotient" Text="" Style="{DynamicResource TextBlockStyle}" d:Width="24" />
            <TextBlock Grid.Column="6" Text=" " Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Grid.Column="7" Text="(" Style="{DynamicResource TextBlockStyle}" />
            <Label Grid.Column="8" Content="mod" Style="{DynamicResource TextControlStyle}" />
            <TextBlock Grid.Column="9" Text=" " Style="{DynamicResource TextBlockStyle}" />
            <poly:PolynomialControl  Grid.Column="10" x:Name="modulusPolynomialCtrl"
                                     Width="Auto" Height="Auto" MinHeight="30"
									 Style="{DynamicResource PolynomialControlStyle}" />
            <TextBlock Grid.Column="11" Text=" " Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Grid.Column="12" Text=")" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Grid.Column="13" />
        </Grid>

        <WrapPanel Grid.Row="5" Style="{DynamicResource WrapPanelStyle}" >
            <TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBox x:Name="integerTotal_Quotient" Text="0" Style="{DynamicResource TextBoxStyle}" />
        </WrapPanel>

        <WrapPanel Grid.Row="6" Style="{DynamicResource WrapPanelStyle}">
            <TextBlock Text="≡" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBox x:Name="integerTotal_QuotientMod" Text="0" Style="{DynamicResource TextBoxStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBlock Text="(" Style="{DynamicResource TextBlockStyle}" />
            <Label Content="mod" Style="{DynamicResource TextControlStyle}" />
            <poly:Coefficient x:Name="modulusInteger"					 
						 Value="{Binding Path=Modulus, Mode=TwoWay}"
						 Style="{DynamicResource TextControlStyle}" 
						 ValueChanged="numberboxControl_ValueChanged" />
            <TextBlock Text=")" Style="{DynamicResource TextBlockStyle}" />
        </WrapPanel>

    </Grid>
</Page>
