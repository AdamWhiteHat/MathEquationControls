<Page x:Class="TestMathEquationControls.CompositeControls.BaseMExpansion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestMathEquationControls.CompositeControls"
        xmlns:poly="clr-namespace:MathEquationControls.CustomControls.Polynomial;assembly=MathEquationControls"
		xmlns:mathctrls="clr-namespace:MathEquationControls.CustomControls;assembly=MathEquationControls"
		xmlns:converters="clr-namespace:MathEquationControls.Converters;assembly=MathEquationControls"
        mc:Ignorable="d"
        Title="Base M Expansion"
		Height="NaN" Width="NaN">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1">
            <Border.BorderBrush>
                <SolidColorBrush Color="Black"/>
            </Border.BorderBrush>
            <Grid>
                <TextBlock Margin="10" Style="{DynamicResource TextBlockStyle}" FontSize="16" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Run FontWeight="Bold">Description:</Run>
                    Generates a <Run Style="{DynamicResource GreenUnderline}">given-degree</Run> polynomial that evaluates to the <Run Style="{DynamicResource BlueUnderline}">target value</Run> when the indeterminate is the <Run  Style="{DynamicResource OrangeUnderline}">specified value</Run>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <WrapPanel HorizontalAlignment="Center" Style="{DynamicResource WrapPanelStyle}">


                    <!--TextBlock Style="{StaticResource TextBlockStyle}">
                        <Run Style="{StaticResource OrangeUnderline}">X</Run> =
                    </TextBlock-->

                    <Label Style="{DynamicResource TextControlStyle}" >
                        <Label.Content>
                            <TextBlock>
                                <Run Style="{DynamicResource OrangeUnderline}">X</Run> =
                            </TextBlock>
                        </Label.Content>
                    </Label>

                    <mathctrls:NumberBox x:Name="ctrlPolynomialBaseM"
                                         DataContext="{Binding ElementName=polyControl, Mode=OneWay}"
                                         Value="{Binding Path=IndeterminateValue, Mode=TwoWay}" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right"  Style="{DynamicResource WrapPanelStyle}">
                    <Label Style="{DynamicResource TextControlStyle}" >
                        <Label.Content>
                            <TextBlock>
                                <Run Style="{DynamicResource GreenUnderline}">degree</Run> =
                            </TextBlock>
                        </Label.Content>
                    </Label>
                    <mathctrls:NumberBox x:Name="ctrlDegree"
                                         DataContext="{Binding ElementName=polyControl, Mode=OneWay}"
                                         Value="{Binding Path=Degree, Mode=TwoWay}" 
                                         Margin="0,0,30,0"
                                         Minimum="0" Maximum="10"  SmallChange="1" MediumChange="1" LargeChange="1" />
                </WrapPanel>
            </Grid>
        </Border>


        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource StackPanelStyle}">
                    <poly:PolynomialControl x:Name="polyControl" 
											DockToParent="False"
                                            IsLockingEnabled="True"
											Style="{DynamicResource PolynomialControlStyle}"                                                        
                                            Text="12*X^5 + 11*X^4 + 2*X^3 + 4*X^2 + 3*X"
                                            d:Text="X^3 - X^2 - 12*X + 35"
											/>
                </StackPanel>
                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15,7"
                          DataContext="{Binding ElementName=polyControl, Mode=OneWay}"
                          IsChecked="{Binding AllowNegativeCoefficients, Mode=TwoWay}"
						  FontFamily="Libertinus Math Regular" FontSize="17" 
						  x:Name="checkboxSmallCoefficients" Content="Reduce coefficient size" />
            </Grid>
        </Border>



        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <StackPanel HorizontalAlignment="Center"  Style="{DynamicResource StackPanelStyle}">
                    <WrapPanel HorizontalAlignment="Center">
                        <Label Content="=" Style="{DynamicResource TextControlStyle}" />
                        <mathctrls:NumberBox x:Name="ctrlTargetValue" 
                                             DataContext="{Binding ElementName=polyControl, Mode=OneWay}"
                                             Value="{Binding TargetValue, Mode=TwoWay}" />
                        <CheckBox x:Name="targetValueLock" IsChecked="True" IsEnabled="False" Style="{DynamicResource ToggleLockStyle}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Style="{DynamicResource TextBlockStyle}" >
                        <Run Style="{StaticResource BlueUnderline}">(target value)</Run>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Page>
