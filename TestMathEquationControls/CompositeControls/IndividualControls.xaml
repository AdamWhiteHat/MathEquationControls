<Window x:Class="TestMathEquationControls.CompositeControls.IndividualControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestMathEquationControls.CompositeControls"
		xmlns:mathctrls="clr-namespace:MathEquationControls;assembly=MathEquationControls"
		xmlns:converters="clr-namespace:MathEquationControls.Converters;assembly=MathEquationControls"
        mc:Ignorable="d"
        Title="Individual Controls Example"
        Height="Auto" Width="600"        
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" MinHeight="100" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <mathctrls:NumberBox x:Name="controlNumberBox" d:Text="6" Text="-7" />
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <mathctrls:Coefficient x:Name="controlCoeddicient" d:Text="6"  Text="-7" />
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <mathctrls:PolynomialTermControl  x:Name="controlPolynomialTermControl" d:Text="-3*X^2" Text="X" />
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <mathctrls:PolynomialControl  x:Name="controlPolynomialControl" d:Text="3*X^3 + X^2 + 1" Text="X - 1"/>
            </Grid>
        </Border>

    </Grid>
</Window>
