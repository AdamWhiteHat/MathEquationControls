<Window x:Class="TestMathEquationControls.Polynomials.PolynomialQuotientField"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestMathEquationControls.Polynomials"
        Title="PolynomialQuotientField"
		xmlns:mathctrls="clr-namespace:MathEquationControls;assembly=MathEquationControls"
		xmlns:converters="clr-namespace:MathEquationControls.ValueConverters;assembly=MathEquationControls"
        mc:Ignorable="d"
		ContentRendered="Window_ContentRendered"
		Height="594" Width="800">
    <Window.Resources>
        <converters:StringToBigIntegerConverter x:Key="String2BigIntegerConverter" />

        <Style x:Key="WrapPanelStyle" TargetType="WrapPanel">
            <Setter Property="HorizontalAlignment"  Value="Center" />
            <Setter Property="VerticalAlignment"  Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="1" Style="{DynamicResource WrapPanelStyle}">
            <Label Content="X =" Style="{DynamicResource TextControlStyle}" />
            <mathctrls:Coefficient x:Name="xIntegerValue" d:Text="1"
								 Value="{Binding Path=BaseValue, Mode=TwoWay}"
								 Style="{DynamicResource TextControlStyle}" 
								 ValueChanged="numberboxControl_ValueChanged"
								 />

        </WrapPanel>

        <WrapPanel Grid.Row="2" Style="{DynamicResource WrapPanelStyle}">
            <mathctrls:PolynomialControl x:Name="dividendPolynomialCtrl"
                                         Width="Auto" Height="Auto" MinHeight="30"
										 
										 Style="{DynamicResource PolynomialControlStyle}" />
        </WrapPanel>

        <WrapPanel Grid.Row="3" Style="{DynamicResource WrapPanelStyle}">
            <TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" />
            <TextBox x:Name="integerTotal_Dividend" Text="0" Style="{DynamicResource TextBoxStyle}" />
        </WrapPanel>

        <WrapPanel Grid.Row="4" Style="{DynamicResource WrapPanelStyle}">
            <Label Content="MOD" Style="{DynamicResource TextControlStyle}" />
            <mathctrls:PolynomialControl x:Name="modulusPolynomialCtrl"
									 DockToParent="True"
									 Style="{DynamicResource PolynomialControlStyle}" />
            <Label Width="30" />
          

        </WrapPanel>

        <WrapPanel Grid.Row="5" Style="{DynamicResource WrapPanelStyle}" >
            <TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBlock x:Name="quotient" Text="" Style="{DynamicResource TextBlockStyle}" d:Width="24" />            
        </WrapPanel>

        <WrapPanel Grid.Row="6" Style="{DynamicResource WrapPanelStyle}">
            <TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" Visibility="Collapsed" />
            <TextBox x:Name="integerTotal_Quotient" Text="0" Style="{DynamicResource TextBoxStyle}" Visibility="Collapsed" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBlock Text="≡" Style="{DynamicResource TextBlockStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBox x:Name="integerTotal_QuotientMod" Text="0" Style="{DynamicResource TextBoxStyle}" />
            <TextBlock Text=" " Style="{DynamicResource TextBlockStyle}" Width="13" />
            <TextBlock Text="(" Style="{DynamicResource TextBlockStyle}" />
            <Label Content="mod" Style="{DynamicResource TextControlStyle}" />
            <mathctrls:Coefficient x:Name="modulusInteger"					 
						 Value="{Binding Path=Modulus, Mode=TwoWay}"
						 Style="{DynamicResource TextControlStyle}" 
						 ValueChanged="numberboxControl_ValueChanged" />
            <TextBlock Text=")" Style="{DynamicResource TextBlockStyle}" />
        </WrapPanel>

    </Grid>
</Window>
