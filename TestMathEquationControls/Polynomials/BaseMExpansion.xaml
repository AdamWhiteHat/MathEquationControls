<Window x:Class="TestMathEquationControls.Polynomials.BaseMExpansion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestMathEquationControls.Polynomials"
		xmlns:mathctrls="clr-namespace:MathEquationControls;assembly=MathEquationControls"
		xmlns:converters="clr-namespace:MathEquationControls.ValueConverters;assembly=MathEquationControls"
        mc:Ignorable="d"
        Title="BaseMExpansion"
		Height="450" Width="800"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
		>
    <Window.Resources>
        <converters:StringToBigIntegerConverter x:Key="String2BigIntegerConverter" />
        <converters:StringToAbsoluteValueBigIntegerConverter  x:Key="StringToAbsoluteValueBigIntegerConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <WrapPanel HorizontalAlignment="Center" >
                    <Label Content="m =" Style="{DynamicResource TextControlStyle}" />
                    <mathctrls:NumberBox x:Name="ctrlPolynomialBaseM" d:DataContext="-2" Value="{Binding Path=PolynomialBaseM}" MinWidth="30" MinHeight="60" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Label Content="degree:" Style="{DynamicResource TextControlStyle}" />
                    <mathctrls:NumberBox x:Name="ctrlDegree" Value="{Binding Path=PolynomialDegree, Mode=TwoWay}" />
                </WrapPanel>
            </Grid>
        </Border>


        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mathctrls:PolynomialControl x:Name="polyControl" 
											 DockToParent="False"
											 Style="{DynamicResource PolynomialControlStyle}"
                                             Height="Auto" Width="Auto" d:Text="X^3 - X^2 - 12*X + 35"
											 />
                <WrapPanel x:Name="wrappanelTermLocks" HorizontalAlignment="Center">
                    <d:CheckBox Style="{DynamicResource ToggleLockStyle}" Content="3" />
                </WrapPanel>
            </StackPanel>
        </Border>



        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <StackPanel HorizontalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Center">
                        <Label Content="=" Style="{DynamicResource TextControlStyle}" />
                        <mathctrls:NumberBox x:Name="ctrlTargetValue" Value="{Binding Path=TargetValue, Mode=TwoWay}" />
                    </WrapPanel>
                    <Label Content="(target value)" Style="{DynamicResource TextControlStyle}" />
                </StackPanel>
                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,5"
						  FontFamily="Libertinus Math Regular" FontSize="17" IsChecked="True"
						  x:Name="checkboxSmallCoefficients" Content="Reduce coefficient size" />
            </Grid>
        </Border>

    </Grid>
</Window>
