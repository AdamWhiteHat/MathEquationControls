<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:local="clr-namespace:TestMathEquationControls.StylisticControls">

    <Style TargetType="{x:Type local:WatermarkImagePanel}">
        <Setter Property="ItemsControl.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WatermarkImagePanel}">

                    <Grid x:Name="PART_Grid" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                            <Grid Grid.Column="0" Grid.Row="0">

                            <local:WatermarkImagePanel />

                            <Grid.Background>
                                    <DrawingBrush Stretch="None"  Opacity="1" TileMode="None">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <ImageDrawing x:Name="imageDrawing" Rect="0,0,951,496" ImageSource="{StaticResource HexagonsHorizontalImageSource1}" />
                                                <GeometryDrawing>
                                                    <GeometryDrawing.Brush>
                                                        <SolidColorBrush Color="MistyRose" Opacity="0.6" />
                                                    </GeometryDrawing.Brush>
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,951,496" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.Background>

                                <!--Grid.Effect>
                                    <BlurEffect Radius="5" KernelType="Gaussian" />
                                </Grid.Effect-->

                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="0" Background="Transparent"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >

                                <StackPanel Grid.Column="0" x:Name="PART_StackPanel" 
                                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"                                   
                                            IsItemsHost="True"
                                            Width="NaN" Height="NaN"
                                            Background="Transparent"                                            
                                />

                            </Grid>

                        </Grid>

                    
                    <!--Grid x:Name="PART_Grid"                          
                          MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                          Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                          Opacity="{TemplateBinding Opacity}"                          
                          Visibility="{TemplateBinding Visibility}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="0" Grid.Row="0">

                            <Grid.Background>
                                <DrawingBrush Stretch="None" Opacity="{Binding ImageOpacity}" TileMode="None">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <ImageDrawing x:Name="imageDrawing" ImageSource="{Binding BackgroundImageSource}" Rect="0,0,951,496" />
                                            <GeometryDrawing>
                                                <GeometryDrawing.Brush>
                                                    <SolidColorBrush Color="GhostWhite" Opacity="0.6" />
                                                </GeometryDrawing.Brush>
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,951,496" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>

                            <Grid.Effect>
                                <BlurEffect Radius="{Binding BlurRadius}" KernelType="Gaussian" />
                            </Grid.Effect>

                        </Grid>

                        <Grid Grid.Column="0" Grid.Row="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" x:Name="PART_StackPanel"
                                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"                                   
                                        IsItemsHost="True"
                                        Width="NaN" Height="NaN"
                                        Background="Transparent"
                                        
                            />

                        </Grid>

                    </Grid-->


                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>