<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MathEquationControls"
    xmlns:primitives="clr-namespace:MathEquationControls.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/Fraction.xaml"/>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/PolynomialTermControl.xaml"/>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/PolynomialControl.xaml"/>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/NumberBox.xaml" />
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ToggleLockStyle" TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Column="0" Grid.Row="0" Width="Auto" Height="Auto" VerticalAlignment="Center"  HorizontalAlignment="Center">
                            <TextBlock Text="&#x1f512;" Name="LockIcon" FontSize="25" LineHeight="Auto" TextAlignment="Center" Foreground="Green" />
                        </Grid>
                        <ContentPresenter 
                            Grid.Column="1" Grid.Row="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="8 16"                     
                            Height="Auto" Width="Auto"
                            RecognizesAccessKey="True" 
                            TextBlock.Foreground="{TemplateBinding Foreground}" 
                            TextBlock.LineHeight="Auto"
                            />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="LockIcon" Property="Text" Value="&#x1f512;" />
                            <!-- Locked -->
                            <Setter TargetName="LockIcon" Property="Foreground" Value="Green" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Text" TargetName="LockIcon" Value="&#x1f513;" />
                            <!-- Unlocked -->
                            <Setter TargetName="LockIcon" Property="Foreground" Value="Red" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>
