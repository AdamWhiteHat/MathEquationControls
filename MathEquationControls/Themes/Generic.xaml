<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MathEquationControls"
    xmlns:primitives="clr-namespace:MathEquationControls.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/Fraction.xaml"/>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/PolynomialTermControl.xaml"/>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/PolynomialControl.xaml"/>
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/NumberBox.xaml" />
        <ResourceDictionary Source="/MathEquationControls;component/CustomControls/Coefficient.xaml" />
        <ResourceDictionary Source="/MathEquationControls;component/Styles/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ToggleLockStyle" TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Width="{TemplateBinding Width}">
                        <WrapPanel Orientation="Horizontal" Background="{TemplateBinding Background}" HorizontalAlignment="Center">
                            <TextBlock Name="LockIcon" Text="&#x1f512;" FontSize="25" Foreground="Red"                                                                     
                                    Width="Auto" Height="Auto" LineHeight="Auto"                                    
                                    VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <ContentPresenter                
                            Height="Auto" Width="Auto" TextBlock.LineHeight="Auto"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            TextBlock.TextAlignment="Center"
                            RecognizesAccessKey="True"
                            TextBlock.Foreground="{TemplateBinding Foreground}"                             
                       />
                        </WrapPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="LockIcon" Property="Text" Value="&#x1f512;" />
                            <!-- Locked -->
                            <Setter TargetName="LockIcon" Property="Foreground" Value="Red" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Text" TargetName="LockIcon" Value="&#x1f513;" />
                            <!-- Unlocked -->
                            <Setter TargetName="LockIcon" Property="Foreground" Value="Green" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>
