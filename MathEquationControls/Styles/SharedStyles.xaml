<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:MathEquationControls.ValueConverters"
					xmlns:local="clr-namespace:MathEquationControls"					
					>

    <!-- Root styles -->

    <Style x:Key="FrameworkElementStyle" TargetType="FrameworkElement">
        <Setter Property="HorizontalAlignment"  Value="Center" />
        <Setter Property="VerticalAlignment"  Value="Center" />
    </Style>

    <Style x:Key="ControlStyle" TargetType="Control" BasedOn="{StaticResource FrameworkElementStyle}" >
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="HorizontalContentAlignment"  Value="Center" />
        <Setter Property="VerticalContentAlignment"  Value="Center" />
    </Style>

    <!-- NumberBox Controls -->

    <Style x:Key="NumberBox_Default_BorderStyle" TargetType="Border">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />

        <Setter Property="HorizontalAlignment"  Value="Center" />
        <Setter Property="VerticalAlignment"  Value="Center" />

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="BorderBrush" Value="LightGray" />
    </Style>

    <Style x:Key="NumberBox_Default_TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Padding" Value="0,5,0,5" />

        <Setter Property="Cursor" Value="ScrollNS" />

        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextAlignment" Value="Center" />

        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>

        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Focusable" Value="True" />
    </Style>

    <Style x:Key="NumberBox_TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NumberBox_Default_TextBoxStyle}">
        <Setter Property="Text">
            <Setter.Value>
                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}">
                    <Binding.Converter>
                        <converters:BigIntegerToStringConverter />
                    </Binding.Converter>
                </Binding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Coefficient_TextBoxStyle" TargetType="TextBox"  BasedOn="{StaticResource NumberBox_Default_TextBoxStyle}">
        <Setter Property="Text">
            <Setter.Value>
                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}">
                    <Binding.Converter>
                        <converters:AbsoluteBigIntegerToStringConverter />
                    </Binding.Converter>
                </Binding>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Polynomial Controls -->

    <Style x:Key="PolynomialControlStyle" TargetType="local:PolynomialControl" BasedOn="{StaticResource  ControlStyle}">
        <Setter Property="BorderThickness" Value="0.5" />
        <!--Setter Property="BorderBrush" Value="Green" /-->
    </Style>

    <Style x:Key="PolynomialTermStyle" TargetType="local:PolynomialTermControl" >
        <!--Setter Property="BorderThickness" Value="0.5" /-->
        <!--Setter Property="BorderBrush" Value="Black" /-->

        <Setter Property="Cursor" Value="ScrollNS" />
        <Setter Property="ForceCursor" Value="True" />
    </Style>

    <!-- Polynomial Control Elements -->

    <Style x:Key="CommonFontStyle" TargetType="TextElement">
        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />
    </Style>

    <Style x:Key="TextElementStyle" TargetType="TextElement" BasedOn="{StaticResource CommonFontStyle}">
        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />
    </Style>

    <Style x:Key="TextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource  FrameworkElementStyle}">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="BaselineOffset" Value="0" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />

        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />

        <Setter Property="Focusable" Value="True" />
    </Style>

    <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource  FrameworkElementStyle}">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextAlignment" Value="Center" />

        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Focusable" Value="True" />
    </Style>

    <Style x:Key="RichTextBoxStyle" TargetType="RichTextBox" BasedOn="{StaticResource  FrameworkElementStyle}">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />

        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />
    </Style>

    <Style x:Key="OperatorStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="ForceCursor" Value="True" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Width" Value="13" />
    </Style>

    <Style x:Key="AdditiveOperatorStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="ExponentStyle" TargetType="Run">
        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BaselineAlignment" Value="Superscript" />
        <Setter Property="Block.LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="TextControlStyle" TargetType="Control" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="FontFamily" Value="Libertinus Math Regular" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="60" />
    </Style>

    <Style x:Key="FocusableParagraph" TargetType="Paragraph">
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style TargetType="{x:Type Run}">
        <Setter Property="BaselineAlignment" Value="Baseline" />
    </Style>

</ResourceDictionary>