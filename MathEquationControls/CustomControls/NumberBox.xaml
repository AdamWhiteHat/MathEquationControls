<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:local="clr-namespace:MathEquationControls.CustomControls"
					xmlns:converters="clr-namespace:MathEquationControls.Converters"
					mc:Ignorable="d">

    <Style TargetType="{x:Type local:NumberBox}">
        <Style.Resources>
            <converters:BigIntegerToStringConverter x:Key="BigInteger2StringConverter" />
            <converters:AbsoluteBigIntegerToStringConverter  x:Key="AbsoluteBigInteger2StringConverter" />
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NumberBox}">
                    <Border x:Name="PART_Border" Style="{DynamicResource NumberBox_Default_BorderStyle}" >
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock>         
                                    <Run FontWeight="Bold">Try:</Run><LineBreak />
                                    <Run>Middle click &amp; Drag Up/Down: Increment/decrement. Step size increases with drag distance</Run><LineBreak />                                                                     
                                    <Run>[Ctrl] + Mouse Wheel: Large step</Run><LineBreak />
                                    <Run>[Shift] + Mouse Wheel: Medium step</Run><LineBreak />
                                    <Run>Mouse Wheel Up/Down: Small step</Run><LineBreak />   
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <WrapPanel Orientation="Horizontal">
                            <TextBox x:Name="PART_TextBox" IsTabStop="True" d:Text="2" Style="{DynamicResource NumberBox_TextBoxStyle}" />
                        </WrapPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="IsTabStop" Value="False" />
    </Style>

</ResourceDictionary>
    