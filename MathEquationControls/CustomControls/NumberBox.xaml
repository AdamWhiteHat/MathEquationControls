<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:local="clr-namespace:MathEquationControls"
					xmlns:converters="clr-namespace:MathEquationControls.ValueConverters"
					mc:Ignorable="d">

    <Style TargetType="{x:Type local:NumberBox}">
        <Style.Resources>
            <converters:StringToBigIntegerConverter x:Key="String2BigIntegerConverter" />
            <converters:StringToAbsoluteValueBigIntegerConverter  x:Key="StringToAbsoluteValueBigIntegerConverter" />
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NumberBox}">
                    <Border x:Name="PART_Border" Style="{DynamicResource NumberBox_Default_BorderStyle}" >
                        <WrapPanel Orientation="Horizontal">
                            <TextBox x:Name="PART_TextBox" d:Text="-2" Style="{DynamicResource NumberBox_TextBoxStyle}" />
                        </WrapPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>
    