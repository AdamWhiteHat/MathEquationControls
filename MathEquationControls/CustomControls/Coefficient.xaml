<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:local="clr-namespace:MathEquationControls"
					xmlns:converters="clr-namespace:MathEquationControls.ValueConverters"
					mc:Ignorable="d">

    <Style TargetType="{x:Type local:Coefficient}">
        <Style.Resources>
            <converters:StringToBigIntegerConverter x:Key="String2BigIntegerConverter" />
        </Style.Resources>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Coefficient}">

                    <Border x:Name="PART_Border"						
							Width="Auto"
							Height="Auto"  >

                        <TextBox x:Name="PART_TextBox" d:Text="1"
                                 Padding="0,5,0,5"
                                 Style="{DynamicResource CoefficientDefaultTextBoxStyle}" >
                            <TextBox.Text>
                                <Binding Path="Value" Mode="TwoWay">
                                    <Binding.Converter>
                                        <converters:StringToBigIntegerConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>