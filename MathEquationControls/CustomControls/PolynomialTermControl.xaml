<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:local="clr-namespace:MathEquationControls"
					xmlns:converters="clr-namespace:MathEquationControls.ValueConverters"
					mc:Ignorable="d">

    <Style TargetType="{x:Type local:PolynomialTermControl}">

        <Style.Resources>
            <converters:StringToBigIntegerConverter x:Key="String2BigIntegerConverter" />
        </Style.Resources>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PolynomialTermControl}">                    
                    <Border x:Name="PART_Border"
							Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Width="Auto"
							Height="Auto"
							HorizontalAlignment="Center"  
                            VerticalAlignment="Center"                           
                            >
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <local:Coefficient x:Name="PART_Coefficient" Value="{Binding Path=Coefficient}"></local:Coefficient>
                            <TextBlock x:Name="PART_MultiplicationSymbol" Width="13" Style="{DynamicResource OperatorStyle}"></TextBlock>
                            <TextBlock x:Name="PART_Indeteminant" Style="{DynamicResource TextBlockStyle}"></TextBlock>
                            <TextBlock x:Name="exponentBlock">
                                <Run x:Name="PART_Exponent" Style="{DynamicResource ExponentStyle}"></Run>
                            </TextBlock>
                        </WrapPanel>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Exponent" Value="0">
                            <Trigger.Setters>
                                <Setter TargetName="PART_MultiplicationSymbol" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_Indeteminant" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="exponentBlock" Property="Visibility" Value="Hidden"/>
                            </Trigger.Setters>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>