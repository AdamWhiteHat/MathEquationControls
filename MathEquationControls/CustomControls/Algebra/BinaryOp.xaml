<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="clr-namespace:MathEquationControls.CustomControls.Algebra">

    <Style x:Key="{x:Type local:BinaryOp}" TargetType="{x:Type local:BinaryOp}">
		<Setter Property="Template">
			<Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BinaryOp}">
					<Border 
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">

						<StackPanel x:Name="PART_ControlStackPanel" 
									Orientation="Vertical" Margin="0,0,0,0"																		
									Width="Auto" Height="Auto"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									Cursor="IBeam" ForceCursor="True"	
									
									MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}"
									Visibility="{TemplateBinding Visibility}" IsEnabled="{TemplateBinding IsEnabled}"															
									>

							<TextBlock x:Name="PART_LeftOperandTextBlock" Text="{TemplateBinding LeftOperand}" />
                            
							<TextBlock x:Name="PART_RightOperandTextBlock" Text="{TemplateBinding RightOperand}" />


						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>