<UserControl x:Class="MathEquationControls.CustomControls.Algebra.Fraction"    
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:MathEquationControls.CustomControls.Algebra"
            mc:Ignorable="d"         
            Width="Auto" Height="Auto"
            VerticalAlignment="Center" HorizontalAlignment="Center"
            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
            Background="White"     
            Focusable="True"            
            IsTabStop="False" 
            DataContext="{Binding RelativeSource={RelativeSource Self}}"            
            >

    <UserControl.Resources>
        <Style x:Key="Algebra_Fraction_TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Libertinus Math Regular" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Cursor" Value="IBeam" />

            <Setter Property="Focusable" Value="true" />
            <Setter Property="IsTabStop" Value="true" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />

            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="TextAlignment" Value="Center" />

            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="Auto" />

            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding"  Value="3,2" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Opacity" Value="1" />

        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{Binding BorderBrush}"	BorderThickness="{Binding BorderThickness}">

        <StackPanel x:Name="ControlStackPanel" 
							Orientation="Vertical" Margin="0,0,0,0"																		
							Width="Auto" Height="Auto"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Cursor="IBeam" ForceCursor="True"													
							>

            <TextBox x:Name="NumeratorTextBox" Text="{Binding Numerator}" d:Text="1" Style="{DynamicResource Algebra_Fraction_TextBoxStyle}" />
            <Separator BorderBrush="Black" />
            <TextBox x:Name="DenominatorTextBox" Text="{Binding Denominator}" d:Text="2"  Style="{DynamicResource Algebra_Fraction_TextBoxStyle}" />

        </StackPanel>
    </Border>

</UserControl>