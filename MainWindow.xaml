<Window x:Class="MathEquationControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MathEquationControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Button Grid.Row="0" x:Name="btnAdd" Content="Add" Height="20" Width="40" Click="Add_Click" />

		<WrapPanel Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Center" >
			<local:PolynomialControl x:Name="polynomialCtrl"
									 DockToParent="True"
									 Style="{DynamicResource PolynomialControlStyle}"
									 PolynomialUpdated="polynomialCtrl_PolynomialUpdated" />
			<TextBlock Width="30" />
			<TextBox x:Name="outputTextBox" Width="200" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" />
		</WrapPanel>


	</Grid>
</Window>
