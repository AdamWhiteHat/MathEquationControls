<Window x:Class="MathEquationControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MathEquationControl"
		xmlns:converters="clr-namespace:MathEquationControl.ValueConverters"
        mc:Ignorable="d"
		ContentRendered="Window_ContentRendered"
        Title="MainWindow" 
		Height="800" Width="800">
	<Window.Resources>
		<converters:StringToBigIntegerConverter x:Key="String2BigIntegerConverter" />
	</Window.Resources>

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border BorderBrush="Black" BorderThickness="1">
			<local:PolynomialControl Grid.Row="0"
								 x:Name="dividendPolynomialCtrl"
								 DockToParent="True"
								 Style="{DynamicResource PolynomialControlStyle}" />
		</Border>

		<WrapPanel Grid.Row="1" HorizontalAlignment="Center">
			<Label Content="MOD" Style="{DynamicResource TextControlStyle}" />
			<local:PolynomialControl x:Name="modulusPolynomialCtrl"
									 DockToParent="True"
									 Style="{DynamicResource PolynomialControlStyle}" />
			<Label Width="30" />
			<Label Content="MOD" Style="{DynamicResource TextControlStyle}" />
			<local:NumberBox x:Name="modulusInteger" 
							 Value="{Binding Path=Modulus, Mode=TwoWay, Converter={StaticResource String2BigIntegerConverter}}"
							 Style="{DynamicResource TextControlStyle}" 
							 ValueChanged="modulusInteger_ValueChanged" />

		</WrapPanel>

		<WrapPanel Grid.Row="2" HorizontalAlignment="Center">
			<TextBlock Text="=" Style="{DynamicResource TextBlockStyle}" />
			<TextBlock x:Name="quotient" Text="" Style="{DynamicResource TextBlockStyle}" />
		</WrapPanel>

	</Grid>
</Window>
