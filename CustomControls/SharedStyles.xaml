<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="clr-namespace:MathEquationControl">

	<Style x:Key="PolynomialControlStyle" TargetType="local:PolynomialControl">
		<Setter Property="BorderBrush" Value="Red" />
		<Setter Property="BorderThickness" Value="0.5" />

		<Setter Property="Height" Value="Auto" />

		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
	</Style>

	<Style x:Key="PolynomialTermStyle" TargetType="local:PolynomialTermControl">
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />

		<Setter Property="Height" Value="Auto" />

		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="ForceCursor" Value="True" />		

		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
	</Style>

	<Style x:Key="RichTextStyle" TargetType="RichTextBox">
		<Setter Property="BorderBrush" Value="Green" />
		<Setter Property="BorderThickness" Value="1" />

		<Setter Property="Height" Value="Auto" />

		<Setter Property="FontFamily" Value="Libertinus Math Regular" />
		<Setter Property="FontSize" Value="30" />
		
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="ForceCursor" Value="True" />

		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
	</Style>

	<Style x:Key="FlowDocumentStyle" TargetType="FlowDocument">
		<Setter Property="ColumnWidth" Value="Auto" />
		<Setter Property="LineHeight" Value="Auto" />
		<Setter Property="PageHeight" Value="Auto" />
		<Setter Property="PageWidth" Value="Auto" />

		<Setter Property="FontFamily" Value="Libertinus Math Regular" />
		<Setter Property="FontSize" Value="30" />

		<Setter Property="FlowDirection" Value="LeftToRight" />
		<Setter Property="IsColumnWidthFlexible" Value="True" />

		<Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
		<Setter Property="TextAlignment" Value="Center" />
	</Style>

	<Style x:Key="TextBlockStyle" TargetType="TextBlock">
		<Setter Property="TextWrapping" Value="NoWrap" />
		<Setter Property="TextTrimming" Value="None" />
		<Setter Property="TextAlignment" Value="Center" />

		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style x:Key="ParagraphStyle" TargetType="Paragraph">
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />

		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="ForceCursor" Value="True" />

		<Setter Property="LineStackingStrategy" Value="MaxHeight" />
		<Setter Property="IsHyphenationEnabled" Value="False" />

		<Setter Property="ClearFloaters" Value="Both" />
		<Setter Property="KeepTogether" Value="True" />
		<Setter Property="KeepWithNext" Value="False" />
		<Setter Property="TextAlignment" Value="Center" />
	</Style>

	<Style TargetType="{x:Type Run}">
		<Setter Property="BaselineAlignment" Value="Center" />
	</Style>

	<Style x:Key="Exponent" TargetType="Run">
		<Setter Property="BaselineAlignment" Value="Superscript" />
	</Style>

</ResourceDictionary>