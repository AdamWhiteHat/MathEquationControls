<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="clr-namespace:MathEquationControl">

	<!-- Root styles -->

	<Style x:Key="FrameworkElementStyle" TargetType="FrameworkElement">
		<Setter Property="HorizontalAlignment"  Value="Center" />
		<Setter Property="VerticalAlignment"  Value="Center" />
	</Style>

	<Style x:Key="ControlStyle" TargetType="Control" BasedOn="{StaticResource FrameworkElementStyle}" >
		<Setter Property="Background" Value="Transparent" />

		<Setter Property="HorizontalContentAlignment"  Value="Center" />
		<Setter Property="VerticalContentAlignment"  Value="Center" />
	</Style>

	<!-- Polynomial Controls -->

	<Style x:Key="PolynomialControlStyle" TargetType="local:PolynomialControl" BasedOn="{StaticResource  ControlStyle}">
		<Setter Property="BorderThickness" Value="1" />
		<!--Setter Property="BorderBrush" Value="Green" /-->
	</Style>

	<Style x:Key="PolynomialTermStyle" TargetType="local:PolynomialTermControl"  BasedOn="{StaticResource  ControlStyle}">
		<Setter Property="BorderThickness" Value="1" />
		<!--Setter Property="BorderBrush" Value="Blue" /-->

		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="ForceCursor" Value="True" />
	</Style>

	<!-- Polynomial Control Elements -->

	<Style x:Key="TextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource  FrameworkElementStyle}">
		<Setter Property="Background" Value="Transparent" />

		<Setter Property="TextWrapping" Value="NoWrap" />
		<Setter Property="TextTrimming" Value="None" />
		<Setter Property="TextAlignment" Value="Center" />

		<Setter Property="FontFamily" Value="Libertinus Math Regular" />
		<Setter Property="FontSize" Value="30" />
	</Style>

	<Style x:Key="OperatorStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
		<Setter Property="Cursor" Value="Arrow" />
		<Setter Property="ForceCursor" Value="True" />
	</Style>

	<Style x:Key="TextControlStyle" TargetType="Control" BasedOn="{StaticResource  FrameworkElementStyle}">
		<Setter Property="FontFamily" Value="Libertinus Math Regular" />
		<Setter Property="FontSize" Value="30" />
	</Style>

	<Style TargetType="{x:Type Run}">
		<Setter Property="BaselineAlignment" Value="Center" />
	</Style>

	<Style x:Key="Exponent" TargetType="Run">
		<Setter Property="BaselineAlignment" Value="Superscript" />
	</Style>

</ResourceDictionary>